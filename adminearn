<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>Admin Panel - Earn Wallet</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

  <script src="https://www.gstatic.com/firebasejs/10.8.1/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.8.1/firebase-database-compat.js"></script>

  <style>
    :root { --primary: #6C5CE7; --primary-light: #A29BFE; --bg: #f4f6fb; --surface: #FFF; --text: #2D3436; --green: #00b894; --red: #ff4757; --blue: #0984e3; --orange: #ff9f43; }
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Poppins', sans-serif; }
    body { background: var(--bg); color: var(--text); padding-bottom: 30px; -webkit-tap-highlight-color: transparent;}
    
    .login-overlay{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#4b3ee0,#6C5CE7);padding:20px;}
    .login-card{background:#fff;padding:30px 25px;border-radius:25px;width:100%;max-width:380px;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.4);}
    .login-card i.lock{font-size:3rem;color:var(--primary);margin-bottom:15px;}
    .login-card h2{font-size:1.3rem;margin-bottom:6px;}
    .login-card p{font-size:0.85rem;color:#777;margin-bottom:22px;}
    .login-card input{width:100%;padding:15px;border:2px solid #e1e1e1;border-radius:12px;font-size:1rem;text-align:center;font-weight:700;letter-spacing:3px;outline:none;}
    .login-card input:focus{border-color:var(--primary);box-shadow:0 0 0 4px rgba(108,92,231,.15);}
    .login-card button{width:100%;margin-top:15px;padding:15px;background:linear-gradient(135deg,var(--primary),var(--primary-light));color:#fff;border:none;border-radius:12px;font-weight:800;font-size:1rem;cursor:pointer;}
    .login-error{color:var(--red);font-size:.85rem;margin-top:10px;font-weight:700;display:none;}
    
    .header { background: linear-gradient(135deg, #4b3ee0, var(--primary)); color: #fff; padding: 20px; display:flex; justify-content:space-between; align-items:center; font-size: 1.15rem; font-weight: 800; position: sticky; top:0; z-index:10; box-shadow: 0 4px 15px rgba(108,92,231,0.3); border-radius: 0 0 25px 25px; margin-bottom: 20px;}
    .header .logout{background:rgba(255,255,255,.2);border:none;color:#fff;padding:8px 14px;border-radius:10px;font-size:.8rem;font-weight:700;cursor:pointer;}
    
    .container { max-width: 700px; margin: 0 auto; padding: 0 15px; }
    
    .stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:20px;}
    .stat-card{background:#fff;padding:15px;border-radius:15px;text-align:center;box-shadow:0 4px 12px rgba(0,0,0,.04);}
    .stat-card i{font-size:1.4rem;color:var(--primary);margin-bottom:6px;}
    .stat-card .val{font-size:1.3rem;font-weight:900;}
    .stat-card .lbl{font-size:.7rem;color:#888;font-weight:700;text-transform:uppercase;}
    
    .tabs { display: flex; overflow-x: auto; background: var(--surface); border-radius: 15px; padding: 5px; gap: 5px; margin-bottom: 20px; box-shadow: 0 4px 10px rgba(0,0,0,0.03); scrollbar-width:none; }
    .tabs::-webkit-scrollbar{display:none;}
    .tab { flex: 0 0 auto; padding: 12px 14px; font-weight: 700; color: #888; cursor: pointer; border-radius: 10px; white-space: nowrap; font-size: 0.82rem;}
    .tab.active { background: rgba(108,92,231,0.1); color: var(--primary); }

    .tab-content { display: none; }
    .tab-content.active { display: block; }

    .card { background: var(--surface); padding: 20px; border-radius: 20px; margin-bottom: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); }
    h3 { font-size: 1.05rem; margin-bottom: 15px; border-bottom: 2px dashed #eee; padding-bottom: 10px; color: var(--primary); display: flex; align-items: center; gap: 10px; }
    h3 small{margin-left:auto;font-size:.7rem;color:#888;font-weight:600;}
    
    .form-group { margin-bottom: 15px; }
    label { display: block; font-size: 0.8rem; font-weight: 700; margin-bottom: 6px; color: #444; }
    input, select, textarea { width: 100%; padding: 13px; border: 1px solid #ddd; border-radius: 12px; font-size: 0.9rem; outline: none; background: #fafafa; font-weight: 600; font-family:inherit;}
    input:focus, textarea:focus, select:focus { border-color: var(--primary); background: #fff; box-shadow: 0 0 0 3px rgba(108,92,231,0.1);}
    
    .row-2{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
    
    .btn { width: 100%; background: linear-gradient(135deg, var(--primary), var(--primary-light)); color: #fff; border: none; padding: 14px; border-radius: 12px; font-weight: 800; font-size: 0.95rem; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; margin-top:10px; font-family:inherit;}
    .btn-green { background: linear-gradient(135deg, #00b894, #00cec9); }
    .btn-red { background: linear-gradient(135deg, #ff4757, #ff6b81); }
    .btn-blue { background: linear-gradient(135deg, #0984e3, #74b9ff); }
    .btn-orange { background: linear-gradient(135deg, #ff9f43, #ffb142); }
    .btn-small { width: auto; padding: 8px 12px; font-size: 0.75rem; border-radius: 8px; margin-top:0;}
    
    .ad-slot-card{background:linear-gradient(145deg,#fafbff,#f0f2ff);padding:15px;border-radius:15px;border:2px solid #e8eaff;margin-bottom:14px;position:relative;}
    .ad-slot-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;}
    .ad-slot-head b{font-size:1rem;color:var(--primary);}
    .ad-slot-head .badge{padding:4px 10px;border-radius:20px;font-size:.7rem;font-weight:800;}
    .badge-active{background:rgba(0,184,148,.15);color:var(--green);}
    .badge-off{background:rgba(255,71,87,.15);color:var(--red);}
    .remove-slot-btn{position:absolute;top:10px;right:10px;background:rgba(255,71,87,.1);border:none;color:var(--red);width:28px;height:28px;border-radius:50%;cursor:pointer;font-size:.8rem;display:flex;align-items:center;justify-content:center;}
    
    .slide-card{background:linear-gradient(145deg,#fafbff,#f0f2ff);padding:15px;border-radius:15px;border:2px solid #e8eaff;margin-bottom:14px;position:relative;}
    
    .wd-card { border: 1px solid #eee; padding: 15px; border-radius: 15px; margin-bottom: 15px; background: #fff; }
    .wd-head { display: flex; justify-content: space-between; font-weight: 800; margin-bottom: 12px; border-bottom: 1px dashed #ddd; padding-bottom: 12px; align-items:center;}
    .wd-info { font-size: 0.85rem; color: #555; margin-bottom: 15px; line-height: 1.6; }
    .wd-actions { display: flex; gap: 10px; }
    
    .user-row{display:flex;align-items:center;justify-content:space-between;padding:10px;border-bottom:1px solid #f0f0f0;}
    .user-row:last-child{border:none;}
    .user-info{display:flex;align-items:center;gap:10px;}
    .user-info img{width:38px;height:38px;border-radius:50%;}
    .user-info .name{font-weight:800;font-size:.9rem;display:flex;align-items:center;gap:5px;}
    .user-info .id{font-size:.7rem;color:#888;}
    .user-bal{font-weight:900;color:var(--primary);font-size:.95rem;}
    
    .toast { position: fixed; top: 20px; left: 50%; transform: translateX(-50%); background: #2d3436; color: #fff; padding: 12px 25px; border-radius: 30px; font-size: 0.9rem; opacity: 0; pointer-events: none; transition: 0.3s; z-index: 10000; font-weight: 600; max-width:90%; text-align:center;}
    .toast.show { opacity: 1; top: 30px; }
    
    .empty{text-align:center;padding:30px 10px;color:#888;}
    .empty i{font-size:2.5rem;color:#ccc;margin-bottom:10px;display:block;}
    .info-box{background:#fff7e6;border-left:4px solid #ff9f43;padding:12px 15px;border-radius:10px;margin-bottom:15px;font-size:.8rem;color:#d35400;font-weight:600;line-height:1.6;}
    .info-box i{margin-right:6px;}
    .success-box{background:#e8f8f5;border-left:4px solid #00b894;padding:12px 15px;border-radius:10px;margin-bottom:15px;font-size:.8rem;color:#008b74;font-weight:600;line-height:1.6;}
    .search-user{display:flex;align-items:center;justify-content:space-between;padding:10px;background:#fff;border-radius:10px;margin-bottom:8px;cursor:pointer;border:1px solid #eee;}
    .filter-btns{display:flex;gap:6px;flex-wrap:wrap;}
    .filter-btn{padding:8px 14px;border:none;border-radius:8px;font-weight:700;font-size:.75rem;cursor:pointer;font-family:inherit;}
    .filter-btn.active{transform:scale(1.05);box-shadow:0 4px 12px rgba(0,0,0,.15);}
    .filter-btn:not(.active){opacity:.55;}
  </style>
</head>
<body>

  <div id="loginScreen" class="login-overlay">
    <div class="login-card">
      <i class="fas fa-shield-halved lock"></i>
      <h2>Admin Access</h2>
      <p>Enter admin password to continue</p>
      <input type="password" id="loginPass" placeholder="••••••" maxlength="30">
      <div class="login-error" id="loginErr">❌ Wrong password</div>
      <button onclick="doLogin()"><i class="fas fa-lock-open"></i> Unlock Panel</button>
    </div>
  </div>

  <div id="mainApp" style="display:none;">
    <div class="header">
      <div><i class="fas fa-user-shield"></i> Admin Panel</div>
      <button class="logout" onclick="doLogout()"><i class="fas fa-sign-out-alt"></i> Logout</button>
    </div>

    <div class="container">
      
      <div class="stats-grid">
        <div class="stat-card"><i class="fas fa-users"></i><div class="val" id="statUsers">0</div><div class="lbl">Users</div></div>
        <div class="stat-card"><i class="fas fa-user-check" style="color:#00b894;"></i><div class="val" id="statVerified">0</div><div class="lbl">Verified</div></div>
        <div class="stat-card"><i class="fas fa-hourglass-half" style="color:#ff9f43;"></i><div class="val" id="statPendingV">0</div><div class="lbl">Pending V</div></div>
        <div class="stat-card"><i class="fas fa-hourglass-half" style="color:#0984e3;"></i><div class="val" id="statPending">0</div><div class="lbl">Pending WD</div></div>
      </div>

      <div class="stats-grid" id="extendedStats"></div>

      <div class="tabs">
        <div class="tab active" onclick="switchTab('settings', this)"><i class="fas fa-cog"></i> General</div>
        <div class="tab" onclick="switchTab('slides', this)"><i class="fas fa-images"></i> Slides</div>
        <div class="tab" onclick="switchTab('verification', this)"><i class="fas fa-shield-alt"></i> Verify</div>
        <div class="tab" onclick="switchTab('ads', this)"><i class="fas fa-ad"></i> Ads</div>
        <div class="tab" onclick="switchTab('quiz', this)"><i class="fas fa-question-circle"></i> Quiz</div>
        <div class="tab" onclick="switchTab('tasks', this)"><i class="fas fa-tasks"></i> Tasks</div>
        <div class="tab" onclick="switchTab('promotion', this)"><i class="fas fa-bullhorn"></i> Promotion</div>
        <div class="tab" onclick="switchTab('withdrawals', this)"><i class="fas fa-wallet"></i> Payouts</div>
        <div class="tab" onclick="switchTab('manual', this)"><i class="fas fa-hand-holding-usd"></i> Admin WD</div>
        <div class="tab" onclick="switchTab('users', this)"><i class="fas fa-users-cog"></i> Users</div>
      </div>

      <!-- SETTINGS TAB -->
      <div id="tab-settings" class="tab-content active">
        <div class="card">
          <h3><i class="fas fa-robot"></i> App Info</h3>
          <div class="form-group"><label>Bot Username (without @)</label><input type="text" id="botUsername" placeholder="your_bot"></div>
          <div class="row-2">
            <div class="form-group"><label>Currency Symbol</label><input type="text" id="currencySymbol" placeholder="TK"></div>
            <div class="form-group"><label>Support Link</label><input type="text" id="supportLink" placeholder="https://t.me/..."></div>
          </div>
        </div>

        <div class="card">
          <h3><i class="fas fa-video"></i> Tutorial Videos (Optional)</h3>
          <div class="info-box"><i class="fas fa-info-circle"></i> এক বা একাধিক Link দিন।</div>
          <div class="form-group"><label><i class="fab fa-youtube" style="color:#ff0000;"></i> YouTube URL</label><input type="text" id="tutorialLink" placeholder="https://youtube.com/watch?v=..."></div>
          <div class="form-group"><label><i class="fab fa-facebook" style="color:#1877f2;"></i> Facebook URL</label><input type="text" id="tutorialLinkFb" placeholder="https://facebook.com/watch/..."></div>
          <div class="form-group"><label><i class="fab fa-tiktok"></i> TikTok URL</label><input type="text" id="tutorialLinkTikTok" placeholder="https://tiktok.com/@user/video/..."></div>
        </div>

        <div class="card">
          <h3><i class="fas fa-gift"></i> Bonus System</h3>
          <div class="row-2">
            <div class="form-group"><label>Daily Bonus</label><input type="number" step="0.01" id="dailyBonusAmount" placeholder="20"></div>
            <div class="form-group"><label>Referral Bonus</label><input type="number" step="0.01" id="refBonus" placeholder="5"></div>
          </div>
        </div>

        <div class="card">
          <h3><i class="fas fa-money-bill-wave"></i> Withdrawal Rules</h3>
          <div class="info-box"><i class="fas fa-info-circle"></i> Referral System: One-Time।</div>
          <div class="form-group"><label>Minimum Withdraw Amount</label><input type="number" step="0.01" id="minWithdraw" placeholder="200"></div>
          <div class="row-2">
            <div class="form-group"><label>First Step Referral</label><input type="number" id="firstReferralReq" placeholder="20" oninput="updateTotalRefDisplay()"></div>
            <div class="form-group"><label>Second Step Referral</label><input type="number" id="secondReferralReq" placeholder="10" oninput="updateTotalRefDisplay()"></div>
          </div>
          <div style="background:linear-gradient(135deg,#e8f5ff,#d4ebff);padding:14px;border-radius:12px;margin-bottom:15px;text-align:center;">
            <div style="font-size:.75rem;color:#666;font-weight:700;">Total Referral Required</div>
            <div style="font-size:1.8rem;font-weight:900;color:#0984e3;" id="totalRefDisplay">30</div>
          </div>
          <div class="form-group"><label>Withdraw Notice</label><textarea id="withdrawNotice" rows="2"></textarea></div>
          <div class="form-group"><label>Payment Methods (comma separated)</label><input type="text" id="paymentMethods" placeholder="Bkash, Nagad"></div>
        </div>

        <button class="btn btn-green" onclick="saveSettings()"><i class="fas fa-save"></i> Save General Settings</button>
      </div>

      <!-- SLIDES TAB -->
      <div id="tab-slides" class="tab-content">
        <div class="card">
          <h3><i class="fas fa-images"></i> Slide Banners <small id="slideCount">0 slides</small></h3>
          <div class="info-box"><i class="fas fa-info-circle"></i> Slide যোগ/এডিট/ডিলিট করলে User Panel এ Auto Update হবে।</div>
          <div id="slidesContainer"></div>
          <button class="btn btn-blue" onclick="addNewSlide()"><i class="fas fa-plus"></i> Add New Slide</button>
          <button class="btn btn-red" onclick="resetToDefault()"><i class="fas fa-undo"></i> Reset to Default</button>
        </div>

        <div class="card">
          <h3><i class="fas fa-eye"></i> Live Preview</h3>
          <div id="slidePreview" style="border-radius:20px;overflow:hidden;box-shadow:0 10px 30px rgba(0,0,0,.12);"></div>
        </div>
      </div>

      <!-- VERIFICATION TAB -->
      <div id="tab-verification" class="tab-content">
        <div class="card">
          <h3><i class="fas fa-toggle-on"></i> Verification System</h3>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid #f0f0f0;">
            <div style="flex:1;"><b style="font-size:.95rem;">Verification Required</b><br><small style="font-size:.72rem;color:#888;">ON করলে user কে verify করতে হবে</small></div>
            <label style="position:relative;display:inline-block;width:60px;height:32px;">
              <input type="checkbox" id="verificationEnabled" style="opacity:0;width:0;height:0;">
              <span style="position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;background:#ccc;transition:.3s;border-radius:32px;" id="verifySlider"></span>
            </label>
          </div>
          <div class="form-group" style="margin-top:15px;"><label>Verification Fee</label><input type="number" step="0.01" id="verificationFee" placeholder="50"></div>
          <div class="form-group"><label>Instructions</label><textarea id="verificationNote" rows="3"></textarea></div>
        </div>

        <div class="card">
          <h3><i class="fas fa-phone"></i> Payment Numbers</h3>
          <div class="form-group"><label>bKash Number</label><input type="text" id="bkashNumber" placeholder="01XXXXXXXXX"></div>
          <div class="form-group"><label>Nagad Number</label><input type="text" id="nagadNumber" placeholder="01XXXXXXXXX"></div>
          <div class="form-group"><label>Rocket Number</label><input type="text" id="rocketNumber" placeholder="01XXXXXXXXX"></div>
          <button class="btn btn-green" onclick="saveVerificationSettings()"><i class="fas fa-save"></i> Save</button>
        </div>

        <div class="card">
          <h3><i class="fas fa-list"></i> Pending Verifications <small id="vCount">0</small></h3>
          <div id="vContainer"></div>
        </div>
      </div>

      <!-- ADS TAB -->
      <div id="tab-ads" class="tab-content">
        <div class="card">
          <h3><i class="fas fa-sliders-h"></i> Global Ad Settings</h3>
          <div class="row-2">
            <div class="form-group"><label>Daily Limit</label><input type="number" id="dailyAdLimit" placeholder="10"></div>
            <div class="form-group"><label>Reward</label><input type="number" step="0.01" id="adReward" placeholder="0.5"></div>
          </div>
        </div>

        <div class="card">
          <h3><i class="fas fa-bullhorn"></i> Ad Slots <small id="slotCount">0 slots</small></h3>
          <div id="adsContainer"></div>
          <button class="btn btn-blue" onclick="addNewSlot()"><i class="fas fa-plus"></i> Add New Slot</button>
          <button class="btn btn-green" onclick="saveAds()"><i class="fas fa-save"></i> Save All</button>
        </div>
      </div>

      <!-- QUIZ TAB -->
      <div id="tab-quiz" class="tab-content">
        <div class="card">
          <h3><i class="fas fa-question-circle"></i> Quiz Settings</h3>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid #f0f0f0;">
            <div style="flex:1;"><b style="font-size:.95rem;">Quiz Enabled</b></div>
            <label style="position:relative;display:inline-block;width:60px;height:32px;">
              <input type="checkbox" id="quizEnabled" style="opacity:0;width:0;height:0;">
              <span style="position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;background:#ccc;transition:.3s;border-radius:32px;" id="quizSlider"></span>
            </label>
          </div>
          <div class="row-2" style="margin-top:15px;">
            <div class="form-group"><label>Reward per Quiz</label><input type="number" step="0.01" id="quizReward" placeholder="5"></div>
            <div class="form-group"><label>Time (sec)</label><input type="number" id="quizTime" placeholder="30"></div>
          </div>
          <div class="form-group"><label>Daily Quiz Limit</label><input type="number" id="quizDailyLimit" placeholder="3"></div>
          <button class="btn btn-green" onclick="saveQuizSettings()"><i class="fas fa-save"></i> Save</button>
        </div>

        <div class="card">
          <h3><i class="fas fa-plus-circle"></i> Add New Quiz</h3>
          <div class="form-group"><label>Question</label><textarea id="quizQuestion" rows="2"></textarea></div>
          <div class="row-2">
            <div class="form-group"><label>A</label><input type="text" id="quizOptA"></div>
            <div class="form-group"><label>B</label><input type="text" id="quizOptB"></div>
          </div>
          <div class="row-2">
            <div class="form-group"><label>C</label><input type="text" id="quizOptC"></div>
            <div class="form-group"><label>D</label><input type="text" id="quizOptD"></div>
          </div>
          <div class="row-2">
            <div class="form-group"><label>Correct</label><select id="quizCorrect"><option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="D">D</option></select></div>
            <div class="form-group"><label>Category</label>
              <select id="quizCategory">
                <option value="GK">সাধারণ জ্ঞান</option><option value="Math">গণিত</option>
                <option value="English">ইংরেজি</option><option value="Science">বিজ্ঞান</option>
                <option value="History">ইতিহাস</option><option value="Sports">খেলাধুলা</option>
              </select>
            </div>
          </div>
          <div class="form-group"><label>Publish Date</label><input type="date" id="quizDate"></div>
          <button class="btn btn-green" onclick="addQuiz()"><i class="fas fa-plus"></i> Add Quiz</button>
        </div>

        <div class="card">
          <h3><i class="fas fa-list-check"></i> All Quizzes <small id="quizCount">0</small></h3>
          <div id="quizList"></div>
        </div>

        <div class="card">
          <h3><i class="fas fa-trophy"></i> Today's Winners <small id="winnerCount">0</small></h3>
          <div id="quizWinners"></div>
        </div>
      </div>

      <!-- TASKS TAB -->
      <div id="tab-tasks" class="tab-content">
        <div class="card">
          <h3><i class="fas fa-plus-circle"></i> Add New Task</h3>
          <div class="form-group"><label>Task Name</label><input type="text" id="taskName"></div>
          <div class="row-2">
            <div class="form-group"><label>Reward</label><input type="number" step="0.01" id="taskReward" placeholder="5"></div>
            <div class="form-group"><label>Cooldown (sec)</label><input type="number" id="taskCooldown" placeholder="15"></div>
          </div>
          <div class="form-group"><label>URL</label><input type="text" id="taskUrl" placeholder="https://t.me/..."></div>
          <div class="form-group"><label>Icon URL</label><input type="text" id="taskIcon" placeholder="https://.../icon.png"></div>
          <button class="btn btn-green" onclick="addTask()"><i class="fas fa-plus"></i> Add Task</button>
        </div>
        <div class="card">
          <h3><i class="fas fa-list-check"></i> Tasks <small id="taskCount">0</small></h3>
