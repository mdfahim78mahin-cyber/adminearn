          </div>
          
          <button class="btn btn-green" onclick="confirmManualWithdraw()"><i class="fas fa-paper-plane"></i> Withdraw Now</button>
          <button class="btn btn-red" onclick="cancelManual()"><i class="fas fa-times"></i> Cancel</button>
        </div>`;
    }

    function cancelManual(){
      manualSelectedUser = null;
      document.getElementById('manualUserResult').innerHTML = '';
      document.getElementById('manualUserSearch').value = '';
    }

    async function confirmManualWithdraw(){
      if(!manualSelectedUser) return;
      
      const amount = Number(document.getElementById('manualWithdrawAmount').value);
      const sym = configData.currencySymbol || 'TK';
      
      if(!amount || amount <= 0) return toast('❌ Enter amount');
      if(amount > Number(manualSelectedUser.balance || 0)) return toast('❌ Insufficient');
      
      if(!confirm(`Confirm?\n\n👤 ${manualSelectedUser.name}\n💰 ${amount} ${sym}`)) return;
      
      try {
        await db.ref('withdrawals/WD' + Date.now()).set({
          userId: String(manualSelectedUser.id),
          userName: manualSelectedUser.name || 'User',
          userPhoto: manualSelectedUser.photo || '',
          method: 'Payment', account: 'N/A',
          amount: amount, status: 'approved',
          timestamp: Date.now(), approvedAt: Date.now(), isAdmin: true
        });
        
        await db.ref('users/' + manualSelectedUser.id).update({
          balance: Number(manualSelectedUser.balance || 0) - amount
        });
        
        toast(`✅ Withdrawn ${amount} ${sym}`);
        cancelManual();
        loadManualHistory();
      } catch(e) { toast('❌ ' + e.message); }
    }

    function loadManualHistory(){
      db.ref('withdrawals').on('value', snap => {
        let html = '';
        let count = 0;
        const items = [];
        
        if(snap.exists()){
          snap.forEach(child => {
            const w = child.val();
            if(w.isAdmin === true) items.push(w);
          });
          
          items.sort((a,b) => (b.timestamp || 0) - (a.timestamp || 0));
          count = items.length;
          
          items.slice(0, 20).forEach(w => {
            const date = new Date(w.timestamp).toLocaleString();
            html += `
            <div class="user-row">
              <div class="user-info">
                <img src="${w.userPhoto || 'https://via.placeholder.com/40'}">
                <div><div class="name">${w.userName || 'User'}</div><div class="id">${date}</div></div>
              </div>
              <div style="text-align:right;">
                <div style="font-weight:900;color:#00b894;">-${w.amount} TK</div>
              </div>
            </div>`;
          });
        }
        
        if(count === 0) html = '<div class="empty"><i class="fas fa-hand-holding-usd"></i>No admin withdraws</div>';
        document.getElementById('manualHistoryList').innerHTML = html;
        document.getElementById('manualCount').innerText = count;
      });
    }

    // ========== PROMOTION ==========
    function loadPromoPayment(){
      db.ref('config/promotion').on('value', snap => {
        if(snap.exists()){
          const p = snap.val();
          document.getElementById('promoBkash').value = p.bkash || '';
          document.getElementById('promoNagad').value = p.nagad || '';
          document.getElementById('promoInstructions').value = p.instructions || '';
        }
      });
    }

    function savePromoPayment(){
      db.ref('config/promotion').update({
        bkash: document.getElementById('promoBkash').value.trim(),
        nagad: document.getElementById('promoNagad').value.trim(),
        instructions: document.getElementById('promoInstructions').value.trim()
      }).then(() => toast('✅ Payment info saved!'));
    }

    function loadPromoPrices(){
      db.ref('config/promoPrices').on('value', snap => {
        currentPromoPrices = snap.exists() ? snap.val() : DEFAULT_PROMO_PRICES;
        renderPromoPrices();
      });
    }

    function renderPromoPrices(){
      const container = document.getElementById('promoPricesContainer');
      if(!container) return;
      
      const platforms = [
        { key: 'tiktok', name: '🎵 TikTok', services: ['like', 'comment', 'follower', 'share', 'view'] },
        { key: 'facebook', name: '📘 Facebook', services: ['like', 'comment', 'follower', 'share', 'view'] },
        { key: 'youtube', name: '📺 YouTube', services: ['like', 'comment', 'subscriber', 'view'] },
        { key: 'telegram', name: '📢 Telegram', services: ['subscriber', 'member'] }
      ];
      
      const serviceLabels = {
        like: '👍 Like', comment: '💬 Comment', follower: '👥 Follower',
        share: '🔗 Share', view: '👁️ View', subscriber: '🔔 Subscribe', member: '👥 Member'
      };
      
      let html = '';
      platforms.forEach(p => {
        html += `
          <div style="background:linear-gradient(145deg,#fafbff,#f0f2ff);padding:15px;border-radius:12px;border:2px solid #e8eaff;margin-bottom:14px;">
            <div style="font-weight:900;color:#6C5CE7;font-size:1rem;margin-bottom:12px;">${p.name}</div>`;
        
        p.services.forEach(s => {
          const data = (currentPromoPrices[p.key] && currentPromoPrices[p.key][s]) || { amount: 50, quantity: 100 };
          html += `
            <div style="background:#fff;padding:12px;border-radius:10px;margin-bottom:10px;border:1px solid #eee;">
              <div style="font-weight:800;font-size:.85rem;color:#333;margin-bottom:8px;">${serviceLabels[s]}</div>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div class="form-group" style="margin-bottom:0;">
                  <label style="font-size:.68rem;color:#888;">💵 Amount (TK)</label>
                  <input type="number" step="1" id="pp_amt_${p.key}_${s}" value="${data.amount || 50}" style="padding:8px;font-size:.85rem;">
                </div>
                <div class="form-group" style="margin-bottom:0;">
                  <label style="font-size:.68rem;color:#888;">🔢 Quantity</label>
                  <input type="number" step="1" id="pp_qty_${p.key}_${s}" value="${data.quantity || 100}" style="padding:8px;font-size:.85rem;">
                </div>
              </div>
              <div style="font-size:.7rem;color:#6C5CE7;font-weight:700;margin-top:6px;text-align:center;">
                → <span id="preview_${p.key}_${s}">${data.amount || 50} TK = ${data.quantity || 100}</span>
              </div>
            </div>`;
        });
        
        html += `</div>`;
      });
      
      container.innerHTML = html;
      
      platforms.forEach(p => {
        p.services.forEach(s => {
          const amtEl = document.getElementById(`pp_amt_${p.key}_${s}`);
          const qtyEl = document.getElementById(`pp_qty_${p.key}_${s}`);
          const previewEl = document.getElementById(`preview_${p.key}_${s}`);
          
          if(amtEl && qtyEl && previewEl){
            const update = () => {
              previewEl.innerText = `${amtEl.value} TK = ${qtyEl.value}`;
            };
            amtEl.addEventListener('input', update);
            qtyEl.addEventListener('input', update);
          }
        });
      });
    }

    function savePromoPrices(){
      const platforms = ['tiktok', 'facebook', 'youtube', 'telegram'];
      const services = {
        tiktok: ['like', 'comment', 'follower', 'share', 'view'],
        facebook: ['like', 'comment', 'follower', 'share', 'view'],
        youtube: ['like', 'comment', 'subscriber', 'view'],
        telegram: ['subscriber', 'member']
      };
      
      let prices = {};
      platforms.forEach(p => {
        prices[p] = {};
        services[p].forEach(s => {
          const amtEl = document.getElementById(`pp_amt_${p.key}_${s}`);
          const qtyEl = document.getElementById(`pp_qty_${p.key}_${s}`);
          if(amtEl && qtyEl){
            prices[p][s] = {
              amount: Number(amtEl.value) || 50,
              quantity: Number(qtyEl.value) || 100
            };
          }
        });
      });
      
      db.ref('config/promoPrices').set(prices).then(() => toast('✅ Prices saved!'));
    }

    function loadPromotions(){
      db.ref('promotions').on('value', snap => {
        allPromotions = [];
        if(snap.exists()){
          snap.forEach(child => {
            const p = child.val();
            p.key = child.key;
            allPromotions.push(p);
          });
        }
        renderPromoList();
      });
    }

    function filterPromo(status){
      currentPromoFilter = status;
      ['pending','in_progress','completed','rejected','all'].forEach(s => {
        const btn = document.getElementById('promoF_' + s);
        if(btn) btn.classList.toggle('active', s === status);
      });
      renderPromoList();
    }

    function renderPromoList(){
      const container = document.getElementById('promoContainer');
      if(!container) return;
      
      let filtered = allPromotions;
      if(currentPromoFilter !== 'all') filtered = filtered.filter(p => p.status === currentPromoFilter);
      filtered.sort((a,b) => (b.timestamp || 0) - (a.timestamp || 0));
      
      document.getElementById('promoCount').innerText = filtered.length;
      
      if(filtered.length === 0){
        container.innerHTML = '<div class="empty"><i class="fas fa-bullhorn"></i>No requests</div>';
        return;
      }
      
      let html = '';
      filtered.forEach(p => {
        const date = new Date(p.timestamp).toLocaleString();
        const serviceName = SERVICE_NAMES[p.service] || p.service;
        
        let statusColor = '#ff9f43';
        let statusText = '⏳ PENDING';
        if(p.status === 'in_progress'){ statusColor = '#0984e3'; statusText = '🔄 IN PROGRESS'; }
        else if(p.status === 'completed'){ statusColor = '#00b894'; statusText = '✅ COMPLETED'; }
        else if(p.status === 'rejected'){ statusColor = '#ff4757'; statusText = '❌ REJECTED'; }
        
        html += `
          <div class="wd-card">
            <div class="wd-head">
              <span style="color:#0984e3;background:rgba(9,132,227,.1);padding:4px 12px;border-radius:8px;font-size:.8rem;">${p.method}</span>
              <span style="color:#6C5CE7;font-size:1.2rem;font-weight:900;">${p.amount} TK</span>
            </div>
            
            <div style="margin-bottom:10px;">
              <span style="background:${statusColor}22;color:${statusColor};padding:3px 10px;border-radius:6px;font-size:.75rem;font-weight:800;">${statusText}</span>
            </div>
            
            <div class="wd-info">
              <b>👤 User:</b> ${p.userName || 'User'}<br>
              <b>🆔 ID:</b> <code>${p.userId}</code><br>
              <b>📱 Service:</b> <b style="color:#6C5CE7;">${serviceName}</b><br>
              <b>🔢 Quantity:</b> ${p.quantity}<br>
              <b>🔗 Link:</b> <a href="${p.link}" target="_blank" style="color:#0984e3;">${(p.link||'').substring(0,35)}...</a><br>
              <b>💳 Trx:</b> <span style="color:#00b894;font-weight:800;">${p.transactionId}</span><br>
              <b>📱 Sender:</b> <span style="color:#d63031;font-weight:800;">${p.senderNumber}</span><br>
              ${p.note ? `<b>📝 Note:</b> ${p.note}<br>` : ''}
              <small style="color:#999;">📅 ${date}</small>
            </div>
            
            <div class="wd-actions">
              ${p.status === 'pending' ? `
                <button class="btn btn-blue btn-small" style="flex:1;" onclick="updatePromoStatus('${p.key}', 'in_progress')"><i class="fas fa-play"></i> Start</button>
                <button class="btn btn-red btn-small" style="flex:1;" onclick="rejectPromo('${p.key}')"><i class="fas fa-times"></i> Reject</button>
              ` : ''}
              ${p.status === 'in_progress' ? `
                <button class="btn btn-green btn-small" style="flex:1;" onclick="updatePromoStatus('${p.key}', 'completed')"><i class="fas fa-check"></i> Complete</button>
              ` : ''}
            </div>
          </div>`;
      });
      
      container.innerHTML = html;
    }

    function updatePromoStatus(key, status){
      if(!confirm(`Change status to "${status}"?`)) return;
      db.ref('promotions/' + key).update({ status: status, updatedAt: Date.now() })
        .then(() => toast('✅ Updated!'));
    }

    function rejectPromo(key){
      if(!confirm('Reject this request?')) return;
      db.ref('promotions/' + key).update({ status: 'rejected', rejectedAt: Date.now() })
        .then(() => toast('❌ Rejected!'));
    }

    // ========== USERS ==========
    function loadUsers(){
      db.ref('users').on('value', snap => {
        allUsers = [];
        if(snap.exists()){
          snap.forEach(child => {
            let u = child.val(); u._key = child.key; allUsers.push(u);
          });
          allUsers.sort((a,b) => (b.balance||0) - (a.balance||0));
        }
        document.getElementById('userCount').innerText = allUsers.length;
        document.getElementById('totalUsers2').innerText = allUsers.length;
        filterUsers();
      });
    }

    function filterUserType(type){
      currentUserFilter = type;
      ['fAll','fVerified','fUnverified','fActive','fRich'].forEach(id => {
        const btn = document.getElementById(id);
        if(btn) btn.style.opacity = '0.5';
      });
      const activeBtn = { 'all': 'fAll', 'verified': 'fVerified', 'unverified': 'fUnverified', 'active': 'fActive', 'rich': 'fRich' }[type];
      if(document.getElementById(activeBtn)) document.getElementById(activeBtn).style.opacity = '1';
      filterUsers();
    }

    function filterUsers(){
      const q = (document.getElementById('userSearch').value || '').toLowerCase().trim();
      const today = new Date().toISOString().slice(0, 10);
      
      let filtered = allUsers.filter(u => {
        if(q && !(u.name||'').toLowerCase().includes(q) && !String(u.id||'').includes(q)) return false;
        if(currentUserFilter === 'verified' && u.verified !== true) return false;
        if(currentUserFilter === 'unverified' && u.verified === true) return false;
        if(currentUserFilter === 'active' && u.lastActive !== today) return false;
        if(currentUserFilter === 'rich' && (u.balance || 0) < 10) return false;
        return true;
      });
      
      if(currentUserFilter === 'rich') filtered.sort((a,b) => (b.balance || 0) - (a.balance || 0));
      
      document.getElementById('shownCount').innerText = filtered.length;
      renderUsersAdvanced(filtered);
    }

    function renderUsersAdvanced(users){
      let html = '';
      const sym = configData.currencySymbol || 'TK';
      const today = new Date().toISOString().slice(0, 10);
      const totalRefReq = (Number(configData.firstReferralReq || 20) + Number(configData.secondReferralReq || 10));
      
      if(users.length === 0){
        html = '<div class="empty"><i class="fas fa-users"></i>No users.</div>';
      } else {
        users.forEach(u => {
          const isActiveToday = u.lastActive === today;
          const vBadge = u.verified 
            ? '<span style="background:rgba(0,184,148,.15);color:#00b894;padding:2px 8px;border-radius:6px;font-size:.65rem;font-weight:800;">✅ VERIFIED</span>' 
            : '<span style="background:rgba(255,71,87,.15);color:#ff4757;padding:2px 8px;border-radius:6px;font-size:.65rem;font-weight:800;">❌ UNVERIFIED</span>';
          const activeBadge = isActiveToday ? '<span style="background:rgba(255,159,67,.15);color:#ff9f43;padding:2px 6px;border-radius:5px;font-size:.6rem;font-weight:800;">🔥 TODAY</span>' : '';
          const refs = u.referrals || 0;
          const adCount = u.dailyAds ? Object.values(u.dailyAds).reduce((a,b) => a+b, 0) : 0;
          const quizCorrect = u.quizCorrectCount || 0;
          
          html += `
          <div style="border:1px solid #eee;padding:12px;border-radius:12px;margin-bottom:10px;background:#fff;">
            <div style="display:flex;justify-content:space-between;margin-bottom:10px;">
              <div style="display:flex;align-items:center;gap:10px;">
                <img src="${u.photo || 'https://via.placeholder.com/45'}" style="width:45px;height:45px;border-radius:50%;">
                <div>
                  <div style="font-weight:800;font-size:.9rem;">${u.name || 'User'} ${activeBadge}</div>
                  <div style="font-size:.7rem;color:#888;">ID: ${u.id}</div>
                  <div style="margin-top:4px;">${vBadge}</div>
                </div>
              </div>
              <div style="text-align:right;">
                <div style="font-size:1.15rem;font-weight:900;color:#6C5CE7;">${Number(u.balance||0).toFixed(2)}</div>
                <div style="font-size:.65rem;color:#888;">${sym}</div>
              </div>
            </div>
            
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;margin-bottom:10px;">
              <div style="background:#f0f3f8;padding:8px;border-radius:8px;text-align:center;">
                <div style="font-size:.95rem;font-weight:900;color:${refs >= totalRefReq ? '#00b894' : '#6C5CE7'};">${refs}${refs >= totalRefReq ? ' ✅' : ''}</div>
                <div style="font-size:.6rem;color:#888;font-weight:700;">Refs</div>
              </div>
              <div style="background:#f0f3f8;padding:8px;border-radius:8px;text-align:center;">
                <div style="font-size:.95rem;font-weight:900;color:#00b894;">${adCount}</div>
                <div style="font-size:.6rem;color:#888;font-weight:700;">Ads</div>
              </div>
              <div style="background:#f0f3f8;padding:8px;border-radius:8px;text-align:center;">
                <div style="font-size:.95rem;font-weight:900;color:#ff9f43;">${quizCorrect}</div>
                <div style="font-size:.6rem;color:#888;font-weight:700;">Quiz</div>
              </div>
            </div>
            
            <div style="display:flex;gap:6px;flex-wrap:wrap;">
              <button class="btn btn-green btn-small" style="flex:1;min-width:70px;" onclick="manualWithdrawForUser('${u.id}')"><i class="fas fa-hand-holding-usd"></i> Withdraw</button>
              <button class="btn btn-blue btn-small" style="flex:1;min-width:70px;" onclick="addBalance('${u.id}', '${(u.name || 'User').replace(/'/g, "\\'")}')"><i class="fas fa-plus"></i> Add</button>
              <button class="btn btn-orange btn-small" style="flex:1;min-width:70px;" onclick="viewUserDetails('${u.id}')"><i class="fas fa-eye"></i> Info</button>
            </div>
          </div>`;
        });
      }
      document.getElementById('usersList').innerHTML = html;
    }

    function viewUserDetails(userId){
      const u = allUsers.find(x => String(x.id) === String(userId));
      if(!u) return toast('User not found');
      
      const sym = configData.currencySymbol || 'TK';
      const totalRefReq = (Number(configData.firstReferralReq || 20) + Number(configData.secondReferralReq || 10));
      const adCount = u.dailyAds ? Object.values(u.dailyAds).reduce((a,b) => a+b, 0) : 0;
      
      let details = `
━━━━━━━━━━━━━━━━━━━━━━
👤 USER DETAILS
━━━━━━━━━━━━━━━━━━━━━━
🆔 ID: ${u.id}
📛 Name: ${u.name || 'User'}
💰 Balance: ${Number(u.balance || 0).toFixed(2)} ${sym}
💵 Total Earned: ${Number(u.totalEarned || 0).toFixed(2)} ${sym}
👥 Referrals: ${u.referrals || 0} / ${totalRefReq}
✅ Verified: ${u.verified ? 'YES' : 'NO'}
🎯 Quiz Correct: ${u.quizCorrectCount || 0}
📱 Ads Watched: ${adCount}
📅 Last Active: ${u.lastActive || 'N/A'}
━━━━━━━━━━━━━━━━━━━━━━

Options:
1. Add Balance
2. Remove Balance
3. Manual Verify
4. Delete User
5. Cancel

Enter number (1-5):
`;
      
      const choice = prompt(details);
      if(choice === '1') addBalance(userId, u.name);
      else if(choice === '2') removeBalance(userId, u.name);
      else if(choice === '3') manualVerify(userId);
      else if(choice === '4') deleteUser(userId);
    }

    function manualWithdrawForUser(userId){
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
      document.querySelectorAll('.tab')[8].classList.add('active');
      document.getElementById('tab-manual').classList.add('active');
      setTimeout(() => { selectManualUser(userId); }, 200);
    }

    function addBalance(userId, userName){
      const amt = prompt(`Add balance to "${userName}":`);
      if(!amt || isNaN(amt) || Number(amt) <= 0) return;
      
      const user = allUsers.find(x => String(x.id) === String(userId));
      if(!user) return;
      
      db.ref('users/' + userId).update({ 
        balance: Number(user.balance || 0) + Number(amt),
        totalEarned: Number(user.totalEarned || 0) + Number(amt)
      }).then(() => toast(`✅ Added ${amt} TK`));
    }

    function removeBalance(userId, userName){
      const amt = prompt(`Remove balance from "${userName}":`);
      if(!amt || isNaN(amt) || Number(amt) <= 0) return;
      
      const user = allUsers.find(x => String(x.id) === String(userId));
      if(!user) return;
      
      db.ref('users/' + userId).update({ 
        balance: Math.max(0, Number(user.balance || 0) - Number(amt))
      }).then(() => toast(`✅ Removed ${amt} TK`));
    }

    function manualVerify(userId){
      if(confirm('Verify this user?'))
        db.ref('users/' + userId).update({ verified: true, verifiedAt: Date.now() }).then(() => toast('✅ Verified!'));
    }

    function deleteUser(userId){
      if(!confirm('⚠️ Delete this user permanently?')) return;
      if(!confirm('Are you ABSOLUTELY sure?')) return;
      db.ref('users/' + userId).remove().then(() => toast('🗑️ User deleted'));
    }

    function loadStats(){
      db.ref('users').once('value').then(s => {
        let total = 0, verified = 0;
        s.forEach(c => { total++; if(c.val().verified) verified++; });
        document.getElementById('statUsers').innerText = total;
        document.getElementById('statVerified').innerText = verified;
      });
      db.ref('withdrawals').once('value').then(s => {
        let pending = 0;
        s.forEach(c => { if(c.val().status === 'pending' && !c.val().isAdmin) pending++; });
        document.getElementById('statPending').innerText = pending;
      });
    }
  </script>
</body>
</html>
